{
  "opencollection": "1.0.0",
  "info": {
    "name": "THANOSQL api file metric API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "metric",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Memory Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/metric/memory/",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get Memory Metrics"
        }
      ]
    }
  ],
  "bundled": true
}