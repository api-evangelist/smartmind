          "name": "Post Query",
          "request": {
            "name": "Post Query",
            "description": {
              "content": "Executes queries using either a query string or a query template.\n\n<Note>The `query_string` field holds direct queries or templates that can\nbe modified with specified parameters. You can also recall saved query\ntemplates by their `template_id` or `template_name`. These templates, regardless\nof how they are called, can be used with or without parameters.</Note>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "query",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "schema",
                  "value": "<string>",
                  "description": "The schema to save the created table to. If no parameter is provided, defaults to \"qm\" if table_name is also not specified, and \"public\" otherwise."
                },
                {
                  "disabled": false,
                  "key": "table_name",
                  "value": "<string>",
                  "description": "The name that will be used to create the table produced by the query execution, if any. If not provided, defaults to a randomly generated name."
                },
                {
                  "disabled": false,
                  "key": "overwrite",
                  "value": "false",
                  "description": "Determines if the table shall be overwritten or not if it already exists."
                },
                {
                  "disabled": false,
                  "key": "max_results",
                  "value": "0",
                  "description": "Specifies the maximum number of records that should be returned in the result set (max: 100)."
                }
